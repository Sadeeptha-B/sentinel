#!/bin/sh
# After a pull brings new commits into main, rebuild and reinstall the knight
# with scripts/install-local.ps1. Enable once per clone:
#   git config core.hooksPath scripts/hooks
# Skip it for one pull:
#   SENTINEL_NO_INSTALL=1 git pull
#
# The merge has already happened when this runs, so a failed build leaves the
# pull in place and the installed knight untouched.

[ -n "$SENTINEL_NO_INSTALL" ] && exit 0
[ "$(git symbolic-ref --short -q HEAD)" = main ] || exit 0
# ORIG_HEAD is where main was before the merge, so equal means nothing came in.
[ "$(git rev-parse ORIG_HEAD)" = "$(git rev-parse HEAD)" ] && exit 0
# The installer is Windows-only.
case "$(uname -s)" in MINGW* | MSYS* | CYGWIN*) ;; *) exit 0 ;; esac

exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1
